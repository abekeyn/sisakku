{% comment %}
  阿部農園 コシヒカリ商品ページ - フルカスタムセクション
{% endcomment %}
<style>
  #rice-page-root {
    --navy: #1c2c4d;
    --navy-sub: #131e35;
    --cream: #f6f4ef;
    --beige: #efeae0;
    --text-gray: #5a6472;
    --sub-gray: #8a8574;
    --sub-gray2: #8e9ab0;
    --gold: #d4af5f;
    --border: #ddd5c2;
    --border-dark: #0e1628;
    --offwhite: #e8e2d4;
    background: var(--cream);
    font-family: 'Noto Serif JP', serif;
    color: var(--navy);
  }
  #rice-page-root * { box-sizing: border-box; }
  #rice-page-root a { text-decoration: none; }
  #rice-page-root img { max-width: 100%; display: block; }
  #rice-page-root .label-en {
    font-family: 'Cormorant Garamond', Georgia, serif;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    font-size: 13px;
  }
  #rice-page-root .placeholder-img {
    width: 100%;
    background: repeating-linear-gradient(135deg, #ede7d9 0px, #ede7d9 18px, #e3dcc9 18px, #e3dcc9 36px);
    display: flex; align-items: center; justify-content: center;
  }
  #rice-page-root .placeholder-img span {
    font-family: monospace; font-size: 12px; color: var(--sub-gray); letter-spacing: 0.05em;
  }
  #rice-page-root .placeholder-img.dark {
    background: repeating-linear-gradient(135deg, #1c2c4d 0px, #1c2c4d 18px, #22335c 18px, #22335c 36px);
  }
  #rice-page-root .placeholder-img.dark span { color: var(--sub-gray2); }

  /* ---------- HEADER ---------- */
  #rice-page-root .rp-header {
    background: var(--navy);
    padding: 0 24px;
    height: 64px;
    display: flex; align-items: center; justify-content: space-between;
    position: sticky; top: 0; z-index: 50;
  }
  #rice-page-root .rp-logo {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 16px; letter-spacing: 0.14em; color: var(--offwhite);
    display: flex; align-items: center; gap: 10px;
  }
  #rice-page-root .rp-logo img { height: 44px; width: auto; display: block; }
  #rice-page-root .rp-voice img.placeholder-img { object-fit: cover; }
  #rice-page-root .rp-nav { display: none; gap: 40px; }
  #rice-page-root .rp-nav a { font-size: 14px; color: var(--offwhite); letter-spacing: 0.04em; }
  #rice-page-root .rp-header-right { display: flex; align-items: center; gap: 16px; }

  /* ---------- HERO / PURCHASE ---------- */
  #rice-page-root .rp-hero {
    max-width: 1200px; margin: 0 auto; padding: 40px 20px 60px;
    opacity: 0; transform: translateY(24px); transition: opacity .9s ease, transform .9s ease;
  }
  #rice-page-root .rp-hero.rp-in { opacity: 1; transform: translateY(0); }
  #rice-page-root .rp-gallery-main { height: 340px; width: 100%; object-fit: cover; }
  #rice-page-root .rp-thumbs { display: flex; gap: 8px; margin-top: 10px; }
  #rice-page-root .rp-thumbs .placeholder-img { flex: 1; height: 70px; }
  #rice-page-root .rp-thumbs img { flex: 1; height: 70px; object-fit: cover; }
  #rice-page-root .rp-panel { margin-top: 28px; }
  #rice-page-root .rp-title {
    font-weight: 500; font-size: 24px; color: var(--navy); margin: 10px 0 0;
  }
  #rice-page-root .rp-lead {
    font-size: 14px; line-height: 1.9; color: var(--text-gray); margin: 14px 0 0;
  }
  #rice-page-root .rp-divider { height: 1px; background: var(--border); margin: 22px 0; }
  #rice-page-root .rp-price-row { display: flex; align-items: baseline; gap: 10px; }
  #rice-page-root .rp-price { font-size: 26px; color: var(--navy); }
  #rice-page-root .rp-price-note { font-size: 12px; color: var(--sub-gray); }
  #rice-page-root .rp-field { margin-top: 22px; }
  #rice-page-root .rp-field-label {
    font-size: 12px; color: var(--sub-gray); letter-spacing: 0.04em; margin-bottom: 8px;
  }
  #rice-page-root .rp-toggle-row { display: flex; gap: 10px; flex-wrap: wrap; }
  #rice-page-root .rp-toggle-btn {
    flex: 1; min-width: 60px; padding: 12px 0; border: 1px solid var(--border);
    background: transparent; color: var(--text-gray); font-family: 'Noto Serif JP', serif;
    font-size: 14px; border-radius: 4px; cursor: pointer;
  }
  #rice-page-root .rp-toggle-btn.active {
    border-color: var(--navy); background: var(--navy); color: var(--offwhite);
  }
  #rice-page-root select.rp-select {
    width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 4px;
    background: #fff; font-family: 'Noto Serif JP', serif; font-size: 13px; color: var(--navy);
  }
  #rice-page-root .rp-sum-row {
    display: flex; justify-content: space-between; font-size: 13px; color: var(--sub-gray);
  }
  #rice-page-root .rp-ship-row { margin-top: 22px; padding: 14px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  #rice-page-root .rp-total-row { padding-top: 12px; font-size: 15px; color: var(--navy); }
  #rice-page-root .rp-cta {
    width: 100%; margin-top: 22px; padding: 16px 0; background: var(--navy); color: var(--offwhite);
    border: none; border-radius: 4px; font-family: 'Noto Serif JP', serif; font-size: 15px;
    letter-spacing: 0.06em; cursor: pointer;
  }
  #rice-page-root .rp-cta:disabled { opacity: .6; cursor: default; }
  #rice-page-root .rp-milling-note { font-size: 12px; color: var(--sub-gray); line-height: 1.9; margin-top: 14px; }

  /* ---------- QUALITY BAR ---------- */
  #rice-page-root .rp-quality {
    background: var(--navy); padding: 36px 18px; display: grid; grid-template-columns: 1fr 1fr;
    gap: 20px 0; opacity: 0; transform: translateY(24px); transition: opacity .9s ease, transform .9s ease;
  }
  #rice-page-root .rp-quality.rp-in { opacity: 1; transform: translateY(0); }
  #rice-page-root .rp-quality-item { text-align: center; }
  #rice-page-root .rp-quality-item .label-en { font-size: 11px; }
  #rice-page-root .rp-quality-item .val { font-size: 13px; color: var(--offwhite); margin-top: 8px; }

  /* ---------- TASTE ---------- */
  #rice-page-root .rp-taste {
    max-width: 680px; margin: 0 auto; padding: 56px 24px; text-align: center;
    opacity: 0; transform: translateY(24px); transition: opacity .9s ease, transform .9s ease;
  }
  #rice-page-root .rp-taste.rp-in { opacity: 1; transform: translateY(0); }
  #rice-page-root .rp-taste h2 { font-weight: 500; font-size: 22px; margin: 16px 0 0; }
  #rice-page-root .rp-taste p { font-size: 14px; line-height: 1.95; color: var(--text-gray); margin-top: 18px; }

  /* ---------- EATING WAYS ---------- */
  #rice-page-root .rp-eating {
    padding: 0 18px 56px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
    opacity: 0; transform: translateY(24px); transition: opacity .9s ease, transform .9s ease;
  }
  #rice-page-root .rp-eating.rp-in { opacity: 1; transform: translateY(0); }
  #rice-page-root .rp-eating .placeholder-img { height: 130px; }
  #rice-page-root .rp-eating .cap { text-align: center; font-size: 12px; color: var(--navy); margin-top: 8px; }

  /* ---------- FRESHLY MILLED ---------- */
  #rice-page-root .rp-milled {
    background: var(--beige); padding: 56px 20px;
    opacity: 0; transform: translateY(24px); transition: opacity .9s ease, transform .9s ease;
  }
  #rice-page-root .rp-milled.rp-in { opacity: 1; transform: translateY(0); }
  #rice-page-root .rp-milled-inner { max-width: 1200px; margin: 0 auto; }
  #rice-page-root .rp-milled .placeholder-img { height: 220px; }
  #rice-page-root .rp-milled h2 { font-weight: 500; font-size: 20px; margin: 16px 0 0; line-height: 1.6; }
  #rice-page-root .rp-milled p { font-size: 14px; line-height: 1.95; color: var(--text-gray); margin-top: 16px; }

  /* ---------- PRODUCER VOICE ---------- */
  #rice-page-root .rp-voice {
    padding: 56px 20px; display: flex; flex-direction: column; align-items: center; text-align: center;
    opacity: 0; transform: translateY(24px); transition: opacity .9s ease, transform .9s ease;
  }
  #rice-page-root .rp-voice.rp-in { opacity: 1; transform: translateY(0); }
  #rice-page-root .rp-voice .placeholder-img { width: 140px; height: 140px; border-radius: 50%; }
  #rice-page-root .rp-voice p { font-size: 16px; line-height: 1.85; color: var(--navy); margin-top: 16px; }
  #rice-page-root .rp-voice .who { font-size: 13px; color: var(--sub-gray); margin-top: 14px; }

  /* ---------- SHIPPING INFO ---------- */
  #rice-page-root .rp-shipinfo {
    padding: 40px 20px; border-top: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 24px;
    opacity: 0; transform: translateY(24px); transition: opacity .9s ease, transform .9s ease;
  }
  #rice-page-root .rp-shipinfo.rp-in { opacity: 1; transform: translateY(0); }
  #rice-page-root .rp-shipinfo .ttl { font-size: 12px; color: var(--navy); letter-spacing: 0.03em; }
  #rice-page-root .rp-shipinfo p { font-size: 12px; color: var(--sub-gray); line-height: 1.9; margin-top: 8px; }

  /* ---------- CROSS SELL ---------- */
  #rice-page-root .rp-cross {
    background: var(--navy); padding: 48px 18px;
    opacity: 0; transform: translateY(24px); transition: opacity .9s ease, transform .9s ease;
  }
  #rice-page-root .rp-cross.rp-in { opacity: 1; transform: translateY(0); }
  #rice-page-root .rp-cross-title { text-align: center; }
  #rice-page-root .rp-group-ttl {
    font-size: 12px; color: var(--offwhite); letter-spacing: 0.05em; margin-top: 32px;
    border-bottom: 1px solid var(--border-dark); padding-bottom: 10px;
  }
  #rice-page-root .rp-group-grid { display: flex; flex-direction: column; gap: 22px; margin-top: 20px; }
  #rice-page-root .rp-card .placeholder-img.dark { height: 180px; }
  #rice-page-root .rp-card img { width: 100%; height: 180px; object-fit: cover; }
  #rice-page-root .rp-card-row { display: flex; justify-content: space-between; align-items: baseline; margin-top: 12px; }
  #rice-page-root .rp-card-name { font-size: 14px; color: var(--offwhite); }
  #rice-page-root .rp-card-price { font-size: 14px; color: var(--offwhite); }
  #rice-page-root .rp-card-note { font-size: 10px; color: var(--sub-gray2); margin-top: 4px; }
  #rice-page-root .rp-card-link { font-size: 11px; color: var(--gold); margin-top: 4px; display: inline-block; }

  /* ---------- FOOTER ---------- */
  #rice-page-root .rp-footer {
    background: var(--navy); padding: 32px 20px; text-align: center; border-top: 1px solid var(--border-dark);
  }
  #rice-page-root .rp-footer .rp-logo { font-size: 13px; justify-content: center; }
  #rice-page-root .rp-footer .rp-logo img { height: 52px; }
  #rice-page-root .rp-footer .addr { font-size: 10px; color: var(--sub-gray2); margin-top: 8px; }

  /* ---------- STICKY BAR (mobile) ---------- */
  #rice-page-root .rp-sticky {
    position: sticky; bottom: 0; left: 0; width: 100%; background: var(--cream);
    border-top: 1px solid var(--border); padding: 10px 16px; display: flex; align-items: center; gap: 12px;
    z-index: 40;
  }
  #rice-page-root .rp-sticky .lbl { font-size: 10px; color: var(--sub-gray); }
  #rice-page-root .rp-sticky .amt { font-size: 15px; color: var(--navy); }
  #rice-page-root .rp-sticky button {
    flex: 1.4; padding: 12px 0; background: var(--navy); color: var(--offwhite); border: none;
    border-radius: 4px; font-family: 'Noto Serif JP', serif; font-size: 13px; letter-spacing: 0.05em;
    cursor: pointer;
  }

  /* ---------- DESKTOP ---------- */
  @media (min-width: 900px) {
    #rice-page-root .rp-header { padding: 0 60px; height: 88px; }
    #rice-page-root .rp-logo { font-size: 20px; letter-spacing: 0.16em; }
    #rice-page-root .rp-logo img { height: 60px; }
    #rice-page-root .rp-nav { display: flex; }
    #rice-page-root .rp-hero {
      padding: 90px 60px; display: grid; grid-template-columns: 520px 1fr; gap: 70px; align-items: start;
    }
    #rice-page-root .rp-gallery-main { height: 560px; }
    #rice-page-root .rp-thumbs .placeholder-img, #rice-page-root .rp-thumbs img { height: 120px; }
    #rice-page-root .rp-panel { margin-top: 0; }
    #rice-page-root .rp-title { font-size: 32px; }
    #rice-page-root .rp-price { font-size: 30px; }
    #rice-page-root .rp-quality { grid-template-columns: 1fr 1fr 1fr 1fr; padding: 48px 60px; }
    #rice-page-root .rp-quality-item { border-left: 1px solid var(--border-dark); padding: 0 16px; }
    #rice-page-root .rp-quality-item:first-child { border-left: none; }
    #rice-page-root .rp-taste { padding: 100px 40px; }
    #rice-page-root .rp-taste h2 { font-size: 27px; }
    #rice-page-root .rp-eating { max-width: 1200px; margin: 0 auto; padding: 0 60px 100px; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 22px; }
    #rice-page-root .rp-eating .placeholder-img { height: 190px; }
    #rice-page-root .rp-milled { padding: 100px 60px; }
    #rice-page-root .rp-milled-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: center; }
    #rice-page-root .rp-milled .placeholder-img { height: 380px; }
    #rice-page-root .rp-milled h2 { font-size: 25px; }
    #rice-page-root .rp-voice { max-width: 1000px; margin: 0 auto; padding: 100px 60px; flex-direction: row; text-align: left; gap: 50px; }
    #rice-page-root .rp-voice .placeholder-img { width: 200px; height: 200px; flex-shrink: 0; }
    #rice-page-root .rp-voice p { font-size: 19px; }
    #rice-page-root .rp-shipinfo { max-width: 1200px; margin: 0 auto; padding: 48px 60px 100px; flex-direction: row; gap: 40px; }
    #rice-page-root .rp-shipinfo > div { flex: 1; }
    #rice-page-root .rp-cross { padding: 90px 60px; }
    #rice-page-root .rp-cross-inner { max-width: 1200px; margin: 0 auto; }
    #rice-page-root .rp-group-grid.g1 { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; }
    #rice-page-root .rp-group-grid.g3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 28px; }
    #rice-page-root .rp-card .placeholder-img.dark, #rice-page-root .rp-card img { height: 260px; }
    #rice-page-root .rp-sticky { display: none; }
  }

  #rice-page-root .rp-footer-links {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px;
    margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--border-dark);
    max-width: 760px; margin-left: auto; margin-right: auto;
  }
  #rice-page-root .rp-footer-links a {
    font-size: 11px; color: var(--sub-gray2); line-height: 1.9; text-decoration: none;
  }
  #rice-page-root .rp-footer-links a:hover { color: var(--gold); text-decoration: underline; }
</style>

<div id="rice-page-root">
  <header class="rp-header">
    <div class="rp-logo"><img src="{{ 'logo-farm-white.png' | asset_url }}" alt="阿部農園">阿部農園 ❘ 三百年続く米農家</div>
    <nav class="rp-nav">
      <a href="{{ shop.url }}/collections/all">お米一覧</a>
      <a href="/pages/こだわり">こだわり</a>
      <a href="/pages/送料と配送">送料と配送</a>
    </nav>
    <div class="rp-header-right">
      <a href="{{ routes.cart_url }}" aria-label="カート">
        <svg width="20" height="18" viewBox="0 0 22 20" fill="none"><path d="M1 1H4L6 14H18L20 5H6" stroke="#e8e2d4" stroke-width="1.3"/><circle cx="8" cy="18" r="1.4" fill="#e8e2d4"/><circle cx="16" cy="18" r="1.4" fill="#e8e2d4"/></svg>
      </a>
    </div>
  </header>

  <section class="rp-hero rp-fade">
    <div class="rp-gallery">
      {% if product.featured_image %}
        <img class="rp-gallery-main" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title }}">
      {% else %}
        <img class="rp-gallery-main" src="{{ 'koshihikari-bag.jpg' | asset_url }}" alt="{{ product.title }}">
      {% endif %}
      <div class="rp-thumbs">
        {% for image in product.images limit: 4 %}
          <img src="{{ image | image_url: width: 260 }}" alt="{{ product.title }}">
        {% else %}
          {% for i in (1..4) %}<div class="placeholder-img"><span>0{{ i }}</span></div>{% endfor %}
        {% endfor %}
      </div>
    </div>

    <div class="rp-panel">
      <div class="label-en">AMBER RICE</div>
      <h1 class="rp-title" id="rp-title">琥珀米 コシヒカリ <span id="rp-weight-label">5</span>kg</h1>
      <p class="rp-lead">王道の、もちもち。濃い甘みと、ふっくらとした粘り。</p>
      <div class="rp-divider"></div>

      <div class="rp-price-row">
        <span class="rp-price">¥<span id="rp-price">4,800</span></span>
        <span class="rp-price-note">（税込・送料無料）</span>
      </div>

      <div class="rp-field">
        <div class="rp-field-label">精米方法</div>
        <div class="rp-toggle-row" id="rp-rice-toggle">
          <button type="button" class="rp-toggle-btn active" data-rice="白米">白米</button>
          <button type="button" class="rp-toggle-btn" data-rice="玄米">玄米</button>
        </div>
      </div>

      <div class="rp-field">
        <div class="rp-field-label">内容量</div>
        <div class="rp-toggle-row" id="rp-weight-toggle">
          <button type="button" class="rp-toggle-btn active" data-weight="5">5kg</button>
          <button type="button" class="rp-toggle-btn" data-weight="10">10kg</button>
          <button type="button" class="rp-toggle-btn" data-weight="15">15kg</button>
          <button type="button" class="rp-toggle-btn" data-weight="20">20kg</button>
          <button type="button" class="rp-toggle-btn" data-weight="25">25kg</button>
          <button type="button" class="rp-toggle-btn" data-weight="30">30kg</button>
        </div>
      </div>

      <div class="rp-field">
        <div class="rp-field-label">お届け先の地域</div>
        <select class="rp-select" id="rp-region">
          {% assign regions = "北海道,北東北,南東北,関東,信越,北陸,中部,関西,中国,四国,九州,沖縄" | split: "," %}
          {% for r in regions %}
            <option value="{{ r }}"{% if r == '関東' %} selected{% endif %}>{{ r }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="rp-sum-row rp-ship-row">
        <span>配送料</span>
        <span id="rp-shipping">¥600</span>
      </div>
      <div class="rp-sum-row rp-total-row">
        <span>合計</span>
        <span>¥<span id="rp-total">5,400</span></span>
      </div>

      <button type="button" class="rp-cta" id="rp-add-cart">カートに入れる</button>
      <p class="rp-milling-note" id="rp-milling-note">ご注文後に精米し、24時間以内に発送します。</p>
    </div>
  </section>

  <section class="rp-quality rp-fade">
    <div class="rp-quality-item"><div class="label-en">GRADE</div><div class="val">一等米のみ</div></div>
    <div class="rp-quality-item"><div class="label-en">MILLING</div><div class="val">精米後24時間以内に出荷</div></div>
    <div class="rp-quality-item"><div class="label-en">STORAGE</div><div class="val">10℃以下で保管</div></div>
    <div class="rp-quality-item"><div class="label-en">ORIGIN</div><div class="val">福島県郡山市</div></div>
  </section>

  <section class="rp-taste rp-fade">
    <div class="label-en">THE TASTE</div>
    <h2>噛むほどに、甘い。</h2>
    <p>炊き上がりの香り、ふっくらとした粘り、冷めても落ちない甘み。<br>三百年、この土地で選び抜いてきた一杯です。</p>
  </section>

  <section class="rp-eating rp-fade">
    {% assign eating_ways = "炊きたて白ごはん,卵かけ・お茶漬け,和食の定食,おにぎり" | split: "," %}
    {% for way in eating_ways %}
      <div>
        <div class="placeholder-img"><span>PHOTO</span></div>
        <div class="cap">{{ way }}</div>
      </div>
    {% endfor %}
  </section>

  <section class="rp-milled rp-fade">
    <div class="rp-milled-inner">
      <div class="placeholder-img"><span>MILLING PHOTO</span></div>
      <div>
        <div class="label-en">WHY FRESHLY MILLED</div>
        <h2>精米した瞬間が、<br>一番おいしい瞬間。</h2>
        <p>だから阿部農園は、精米済みの在庫を置きません。<br>ご注文をいただいてから精米し、24時間以内に発送します。<br>——この手間のぶんだけ、おいしい。</p>
      </div>
    </div>
  </section>

  <section class="rp-voice rp-fade">
    <img class="placeholder-img" src="{{ 'producer-portrait.jpg' | asset_url }}" alt="代表 阿部喜臣">
    <div>
      <div class="label-en">VOICE OF THE GROWER</div>
      <p>「届けたいのは、お米じゃなくて、家族の幸せな時間なんです」</p>
      <div class="who">代表　阿部　喜臣</div>
    </div>
  </section>

  <section class="rp-shipinfo rp-fade">
    <div>
      <div class="ttl">配送について</div>
      <p>ご注文確定後、精米・発送準備を行い、通常1〜2営業日以内に発送いたします。</p>
    </div>
    <div>
      <div class="ttl">送料について</div>
