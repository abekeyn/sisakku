<script id="rp-variants-{{ section.id }}" type="application/json">{{ product.variants | json }}</script>
<script>
(function(){
  var root = document.getElementById('rice-page-root');
  if (!root) return;

  var variants = JSON.parse(document.getElementById('rp-variants-{{ section.id }}').textContent);

  var shippingTable = {
    5:  { 北海道:950, 北東北:600, 南東北:600, 関東:600, 信越:600, 北陸:710, 中部:710, 関西:830, 中国:1070, 四国:1070, 九州:1350, 沖縄:1650 },
    10: { 北海道:1050, 北東北:700, 南東北:700, 関東:700, 信越:700, 北陸:810, 中部:810, 関西:930, 中国:1170, 四国:1170, 九州:1450, 沖縄:2050 },
    20: { 北海道:1350, 北東北:1000, 南東北:1000, 関東:1000, 信越:1000, 北陸:1110, 中部:1110, 関西:1230, 中国:1470, 四国:1470, 九州:1750, 沖縄:2950 },
    30: { 北海道:2450, 北東北:1400, 南東北:1400, 関東:1400, 信越:1400, 北陸:2010, 中部:2010, 関西:2330, 中国:2570, 四国:2570, 九州:3650, 沖縄:6150 }
  };

  var state = { rice: '白米', weight: 5, region: '関東' };

  function findVariant() {
    var w = state.weight + 'kg';
    for (var i = 0; i < variants.length; i++) {
      var v = variants[i];
      if (v.option1 === state.rice && v.option2 === w) return v;
    }
    return null;
  }

  function fmt(n) { return Math.round(n).toLocaleString('ja-JP'); }

  function render() {
    var v = findVariant();
    var price = v ? parseFloat(v.price) / 100 : 0;
    var ship = (shippingTable[state.weight] && shippingTable[state.weight][state.region]) || 0;
    var total = price + ship;

    document.getElementById('rp-weight-label').textContent = state.weight;
    document.getElementById('rp-price').textContent = fmt(price);
    document.getElementById('rp-shipping').textContent = ship === 0 ? '無料' : ('¥' + fmt(ship));
    document.getElementById('rp-total').textContent = fmt(total);
    document.getElementById('rp-total-sticky').textContent = fmt(total);
    document.getElementById('rp-milling-note').textContent = state.rice === '玄米'
      ? '玄米は精米せず、ご注文後そのまま発送します。'
      : 'ご注文後に精米し、24時間以内に発送します。';

    var riceBtns = root.querySelectorAll('#rp-rice-toggle .rp-toggle-btn');
    riceBtns.forEach(function(b){ b.classList.toggle('active', b.dataset.rice === state.rice); });
    var weightBtns = root.querySelectorAll('#rp-weight-toggle .rp-toggle-btn');
    weightBtns.forEach(function(b){ b.classList.toggle('active', b.dataset.weight === String(state.weight)); });

    var addBtns = [document.getElementById('rp-add-cart'), document.getElementById('rp-add-cart-sticky')];
    addBtns.forEach(function(btn){
      if (!btn) return;
      btn.disabled = !v || !v.available;
    });
  }

  root.querySelectorAll('#rp-rice-toggle .rp-toggle-btn').forEach(function(b){
    b.addEventListener('click', function(){ state.rice = b.dataset.rice; render(); });
  });
  root.querySelectorAll('#rp-weight-toggle .rp-toggle-btn').forEach(function(b){
    b.addEventListener('click', function(){ state.weight = parseInt(b.dataset.weight, 10); render(); });
  });
  document.getElementById('rp-region').addEventListener('change', function(e){
    state.region = e.target.value; render();
  });

  function addToCart(btn) {
    var v = findVariant();
    if (!v) return;
    var originalText = btn.textContent;
    btn.disabled = true;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: v.id, quantity: 1 }] })
    }).then(function(res){
      if (!res.ok) throw new Error('add to cart failed');
      return res.json();
    }).then(function(){
      btn.textContent = 'カートに追加しました';
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      setTimeout(function(){ btn.textContent = originalText; btn.disabled = false; }, 2200);
    }).catch(function(){
      btn.textContent = 'エラーが発生しました';
      setTimeout(function(){ btn.textContent = originalText; btn.disabled = false; }, 2200);
    });
  }

  document.getElementById('rp-add-cart').addEventListener('click', function(){ addToCart(this); });
  document.getElementById('rp-add-cart-sticky').addEventListener('click', function(){ addToCart(this); });

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) { e.target.classList.add('rp-in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.15 });
  root.querySelectorAll('.rp-fade').forEach(function(el){ io.observe(el); });

  render();
})();
</script>

