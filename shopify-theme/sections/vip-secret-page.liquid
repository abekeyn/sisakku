{% comment %}
  阿部農園 関係者用ページ（社内名称：VIP先行販売用） - パスワード制の非公開ページ。
  顧客間の差別化を感じさせないよう「STAFF ONLY / 関係者用ページ」という地味な表現にしている。
  パスワード: kohaku-vip-7421（クライアント側でSHA-256照合、平文はソースに含めない）
{% endcomment %}
<style>
  #vip-page-root {
    --navy: #1c2c4d;
    --navy-sub: #131e35;
    --cream: #f6f4ef;
    --beige: #efeae0;
    --text-gray: #5a6472;
    --sub-gray: #8a8574;
    --gold: #d4af5f;
    --border: #ddd5c2;
    --border-dark: #0e1628;
    --offwhite: #e8e2d4;
    background: var(--cream);
    font-family: 'Noto Serif JP', serif;
    color: var(--navy);
    min-height: 100vh;
  }
  #vip-page-root * { box-sizing: border-box; }
  #vip-page-root img { max-width: 100%; display: block; }
  #vip-page-root .label-en {
    font-family: 'Cormorant Garamond', Georgia, serif;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    font-size: 13px;
  }

  /* ---------- HEADER ---------- */
  #vip-page-root .rp-header {
    background: var(--navy);
    padding: 0 24px;
    height: 64px;
    display: flex; align-items: center; justify-content: center;
  }
  #vip-page-root .rp-logo {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 16px; letter-spacing: 0.14em; color: var(--offwhite);
    display: flex; align-items: center; gap: 10px;
  }
  #vip-page-root .rp-logo img { height: 44px; width: auto; }

  /* ---------- GATE ---------- */
  #vip-page-root .vip-gate {
    max-width: 380px; margin: 0 auto; padding: 100px 24px;
    text-align: center;
  }
  #vip-page-root .vip-gate h1 {
    font-weight: 500; font-size: 22px; margin: 14px 0 8px;
  }
  #vip-page-root .vip-gate p {
    font-size: 13px; color: var(--text-gray); line-height: 1.8; margin: 0 0 28px;
  }
  #vip-page-root .vip-gate input {
    width: 100%; padding: 14px 16px; border: 1px solid var(--border);
    border-radius: 4px; font-size: 15px; text-align: center;
    letter-spacing: 0.08em; background: #fff; color: var(--navy);
    font-family: 'Noto Serif JP', serif;
  }
  #vip-page-root .vip-gate input:focus { outline: 2px solid var(--gold); }
  #vip-page-root .vip-gate button {
    width: 100%; margin-top: 14px; padding: 14px 0; background: var(--navy);
    color: var(--offwhite); border: none; border-radius: 4px;
    font-family: 'Noto Serif JP', serif; font-size: 15px; letter-spacing: 0.06em;
    cursor: pointer;
  }
  #vip-page-root .vip-gate .vip-error {
    margin-top: 14px; font-size: 12px; color: #b03a2e; display: none;
  }
  #vip-page-root .vip-gate .vip-error.show { display: block; }

  /* ---------- CONTENT ---------- */
  #vip-page-root .vip-content { display: none; }
  #vip-page-root .vip-content.show { display: block; }
  #vip-page-root .vip-hero {
    max-width: 800px; margin: 0 auto; padding: 60px 20px 20px; text-align: center;
  }
  #vip-page-root .vip-hero h1 { font-size: 28px; font-weight: 500; margin: 12px 0; }
  #vip-page-root .vip-hero p { font-size: 14px; color: var(--text-gray); line-height: 1.9; max-width: 480px; margin: 0 auto; }
  #vip-page-root .vip-badge {
    display: inline-block; padding: 5px 12px; background: var(--gold); color: var(--navy);
    font-size: 12px; letter-spacing: 0.06em; border-radius: 3px; margin-top: 6px;
  }
  #vip-page-root .vip-notice {
    max-width: 640px; margin: 40px auto 80px; padding: 32px 24px;
    background: var(--beige); border-radius: 6px; text-align: center;
  }
  #vip-page-root .vip-notice p { font-size: 14px; color: var(--navy); line-height: 2; margin: 0; }
  #vip-page-root .vip-notice .contact {
    margin-top: 18px; font-size: 13px; color: var(--sub-gray);
  }

  /* ---------- PURCHASE ---------- */
  #vip-page-root .vip-purchase {
    max-width: 460px; margin: 40px auto 80px; padding: 32px 28px;
    background: #fff; border: 1px solid var(--border); border-radius: 6px;
  }
  #vip-page-root .vip-purchase h2 {
    font-size: 16px; font-weight: 500; margin: 0 0 4px; text-align: center;
  }
  #vip-page-root .vip-purchase .vip-purchase-sub {
    font-size: 12px; color: var(--sub-gray); text-align: center; margin: 0 0 24px;
  }
  #vip-page-root .vip-field-label {
    font-size: 12px; color: var(--text-gray); margin: 0 0 8px;
  }
  #vip-page-root .vip-option-row {
    display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px;
  }
  #vip-page-root .vip-option-btn {
    padding: 8px 14px; border: 1px solid var(--border); border-radius: 4px;
    background: #fff; color: var(--navy); font-size: 13px; cursor: pointer;
    font-family: 'Noto Serif JP', serif;
  }
  #vip-page-root .vip-option-btn.selected {
    background: var(--navy); color: var(--offwhite); border-color: var(--navy);
  }
  #vip-page-root .vip-option-btn:disabled {
    opacity: 0.35; cursor: not-allowed; text-decoration: line-through;
  }
  #vip-page-root .vip-price-row {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 16px; padding-top: 4px; border-top: 1px solid var(--border);
    padding-top: 16px;
  }
  #vip-page-root .vip-price { font-size: 20px; font-weight: 500; }
  #vip-page-root .vip-qty {
    display: flex; align-items: center; border: 1px solid var(--border); border-radius: 4px;
  }
  #vip-page-root .vip-qty button {
    width: 32px; height: 32px; border: none; background: none; cursor: pointer; font-size: 15px; color: var(--navy);
  }
  #vip-page-root .vip-qty input {
    width: 36px; text-align: center; border: none; font-size: 14px; color: var(--navy);
    font-family: 'Noto Serif JP', serif;
  }
  #vip-page-root .vip-add-btn {
    width: 100%; padding: 13px 0; background: var(--navy); color: var(--offwhite);
    border: none; border-radius: 4px; font-family: 'Noto Serif JP', serif;
    font-size: 14px; letter-spacing: 0.04em; cursor: pointer;
  }
  #vip-page-root .vip-add-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  #vip-page-root .vip-add-msg {
    margin-top: 12px; font-size: 12px; text-align: center; color: var(--navy); display: none;
  }
  #vip-page-root .vip-add-msg.show { display: block; }
  #vip-page-root .vip-cart-link {
    display: block; text-align: center; margin-top: 18px; font-size: 12px;
    color: var(--sub-gray); text-decoration: underline;
  }

  /* ---------- CODE ---------- */
  #vip-page-root .vip-code {
    margin: 0 0 18px; padding: 18px 12px; text-align: center;
    background: var(--beige); border: 1px dashed var(--border); border-radius: 4px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 26px; letter-spacing: 0.14em; color: var(--navy);
  }
  #vip-page-root .vip-code-note {
    margin: 18px 0 0; padding: 0 0 0 18px;
    font-size: 12px; color: var(--sub-gray); line-height: 1.9;
  }

  /* ---------- FOOTER ---------- */
  #vip-page-root .rp-footer {
    background: var(--navy); padding: 32px 20px; text-align: center;
  }
  #vip-page-root .rp-footer .rp-logo { font-size: 13px; justify-content: center; }
  #vip-page-root .rp-footer .rp-logo img { height: 52px; }
  #vip-page-root .rp-footer .addr { font-size: 10px; color: var(--sub-gray); margin-top: 8px; }
</style>

<div id="vip-page-root">
  <header class="rp-header">
    <div class="rp-logo"><img src="{{ 'logo-farm-white.png' | asset_url }}" alt="阿部農園">阿部農園 ❘ 三百年続く米農家</div>
  </header>

  <div class="vip-gate" id="vipGate">
    <div class="label-en">STAFF ONLY</div>
    <h1>関係者用ページ</h1>
    <p>このページは関係者確認用です。</p>
    <input type="password" id="vipPassword" placeholder="パスワードを入力" autocomplete="off">
    <button type="button" id="vipSubmit">進む</button>
    <div class="vip-error" id="vipError">パスワードが違うようです。もう一度お試しください。</div>
  </div>

  <div class="vip-content" id="vipContent">
    <div class="vip-hero">
      <div class="label-en">STAFF ONLY</div>
      <h1>関係者用ページ</h1>
      <p>このページは内部確認用のページです。</p>
    </div>
    <div class="vip-purchase">
      <h2>価格調整コード</h2>
      <p class="vip-purchase-sub">琥珀米 コシヒカリ（白米・玄米／全サイズ）の単発ご注文が27%オフになります。</p>

      <div class="vip-code" id="vipCode">{{ section.settings.coupon_code }}</div>

      <button type="button" class="vip-add-btn" id="vipCopyBtn">コードをコピー</button>
      <div class="vip-add-msg" id="vipCopyMsg"></div>

      <ul class="vip-code-note">
        <li>ご注文手続きの「割引コード」欄に入力してください。</li>
        <li>ご利用回数の制限はありません。</li>
        <li>定期便・他の割引との併用はできません。</li>
      </ul>

      <a href="{{ all_products['コシヒカリ'].url | default: '/collections/all' }}" class="vip-cart-link">商品ページへ進む</a>
    </div>
  </div>

  <footer class="rp-footer">
    <div class="rp-logo"><img src="{{ 'logo-farm-white.png' | asset_url }}" alt="阿部農園">ABE RICE FARM</div>
    <div class="addr">福島県郡山市 ❘ 阿部農園</div>
  </footer>
</div>

<script>
(function () {
  var CORRECT_HASH = 'a56507fa8795e948827d2e0390665d5f0b54c0daebf4af0a8fd2a381cfdbc4b0';
  var STORAGE_KEY = 'abe_vip_unlocked_v1';

  var gate = document.getElementById('vipGate');
  var content = document.getElementById('vipContent');
  var input = document.getElementById('vipPassword');
  var button = document.getElementById('vipSubmit');
  var error = document.getElementById('vipError');

  function unlock() {
    gate.style.display = 'none';
    content.classList.add('show');
  }

  async function sha256Hex(text) {
    var data = new TextEncoder().encode(text);
    var digest = await crypto.subtle.digest('SHA-256', data);
    return Array.from(new Uint8Array(digest)).map(function (b) {
      return b.toString(16).padStart(2, '0');
    }).join('');
  }

  async function tryUnlock() {
    var value = (input.value || '').trim().toLowerCase();
    var hash = await sha256Hex(value);
    if (hash === CORRECT_HASH) {
      try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch (e) {}
      error.classList.remove('show');
      unlock();
    } else {
      error.classList.add('show');
    }
  }

  button.addEventListener('click', tryUnlock);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') tryUnlock();
  });

  try {
    if (sessionStorage.getItem(STORAGE_KEY) === '1') unlock();
  } catch (e) {}
})();

(function () {
  var codeEl = document.getElementById('vipCode');
  var copyBtn = document.getElementById('vipCopyBtn');
  var copyMsg = document.getElementById('vipCopyMsg');
  if (!codeEl || !copyBtn) return;

  copyBtn.addEventListener('click', function () {
    var code = (codeEl.textContent || '').trim();
    var done = function () {
      copyMsg.textContent = 'コードをコピーしました。';
      copyMsg.classList.add('show');
    };
    var fail = function () {
      copyMsg.textContent = 'コピーできませんでした。手動で選択してください。';
      copyMsg.classList.add('show');
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(done).catch(fail);
    } else {
      fail();
    }
  });
})();
</script>

{% schema %}
{
  "name": "関係者用ページ",
  "settings": [
    {
      "type": "text",
      "id": "coupon_code",
      "label": "割引コード",
      "default": "KOHAKU27"
    }
  ],
  "presets": [
    { "name": "関係者用ページ" }
  ]
}
{% endschema %}
